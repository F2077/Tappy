<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store requires the sandbox. Tappy only uses sandbox-safe
         APIs: AVSpeechSynthesizer, NSSound, local NSEvent monitors, and
         its own container's Application Support directory. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
